DB_HOST=localhost
DB_PORT=5432
DB_USER=loanover
DB_PASSWORD=loanover
DB_NAME=loanover
NODE_ENV=development
PORT=3000

JWT_SECRET=change-me-locally

# Google OAuth — only needed for real OAuth flow; omit to use /auth/dev-login instead
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

FRONTEND_URL=http://localhost:5173

# Public base URL of this API — used in the unsubscribe link of notification emails
BACKEND_URL=http://localhost:3000

# Business mode — when 'true', enables the /users and /organization endpoints
# and organization-based runway in projections. Any other value hides them (404).
FEATURE_BUSINESS=false

# Email notifications (Resend HTTP API) — without RESEND_API_KEY emails are skipped with a log line
RESEND_API_KEY=
EMAIL_FROM=LoanOver <no-reply@loanover.app>

# Billing (Stripe) — when FEATURE_BILLING is not 'true' every user is treated as Pro and the
# checkout/portal/webhook endpoints respond 404
FEATURE_BILLING=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
